# Variáveis de ambiente da API. Copie para .env (que não é commitado) e
# exporte antes de rodar, ou configure direto no painel do serviço em produção.
# Os valores abaixo são de DESENVOLVIMENTO LOCAL. Produção: docs/DEPLOY.md.

# Perfil do Spring. Local: não defina. Produção: prod.
# Para criar/redefinir a conta da usuária em produção, acrescente
# criar-usuario (prod,criar-usuario) por UM deploy só: docs/DEPLOY.md, passo 4.
# SPRING_PROFILES_ACTIVE=prod

# Local: o Postgres do docker compose, em formato JDBC, com usuário e senha
# nas duas variáveis de baixo.
# Produção: a string do Neon EXATAMENTE como o console mostra (botão Connect,
# com "Connection pooling" ligado):
#   postgresql://usuario:senha@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# A API converte sozinha para JDBC e tira usuário e senha de dentro dela
# (config/ConversorUrlBanco); DATABASE_USUARIO e DATABASE_SENHA ficam sem uso.
DATABASE_URL=jdbc:postgresql://localhost:5432/cadastro
DATABASE_USUARIO=and
DATABASE_SENHA=and

# Com o host do pooler do Neon ("-pooler"), o Flyway já migra pelo host direto
# (o mesmo, sem "-pooler"), deduzido da DATABASE_URL. Só defina isto para
# apontar o Flyway para outro lugar.
# SPRING_FLYWAY_URL=

# Segredo que assina os tokens de login. Um por ambiente, nunca no git.
# Local: gere com  openssl rand -base64 48
# Produção: o Render gera sozinho (render.yaml, generateValue).
APP_JWT_SEGREDO=troque-isto-por-um-valor-aleatorio-de-no-minimo-32-bytes

# Origens com acesso direto à API pelo navegador (CORS), separadas por
# vírgula, sem barra no fim. O painel web passa pelo proxy do Next (mesma
# origem, ADR-0004), então isto só importa para quem chamar a API direto do
# navegador. O app do celular não usa CORS.
# Produção: a URL de produção da Vercel, ex. https://cadastro-familias-web.vercel.app
APP_CORS_ORIGENS=http://localhost:3000

# true = o cookie de renovação só viaja em HTTPS. Local (http): false.
# Produção: true (já é o padrão do perfil prod).
APP_COOKIE_SEGURO=false

# Porta HTTP. Local: 3333. Produção: a plataforma injeta (o Render usa 10000);
# não defina lá.
PORT=3333

# Atrás de proxy reverso (Render, Fly) use "native", senão o limite de
# tentativas de ativação por IP vira um limite único para todas as agentes.
# Sem proxy (local), deixe "none".
SERVER_FORWARD_HEADERS_STRATEGY=none

# Usados só pelo perfil criar-usuario. O e-mail é obrigatório: sem ele o
# perfil recusa rodar. Produção: o e-mail de login da usuária da associação.
APP_USUARIO_INICIAL_EMAIL=associacao@amigosdone.org.br
APP_USUARIO_INICIAL_NOME=Associação Amigos do Nordeste
