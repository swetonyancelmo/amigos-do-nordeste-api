# Variáveis de ambiente da API. Copie para .env (que não é commitado) e
# exporte antes de rodar, ou configure direto no painel do serviço em produção.

# Local (docker compose) ou o Neon. É URL JDBC: o Neon mostra no console
# "postgresql://usuario:senha@host/neondb?sslmode=require", que NÃO funciona
# aqui. Monte assim, com usuário e senha nas duas variáveis de baixo:
#   jdbc:postgresql://ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Use o host COM "-pooler" para a API — ver docs/decisoes/ADR-0004.
DATABASE_URL=jdbc:postgresql://localhost:5432/cadastro
DATABASE_USUARIO=and
DATABASE_SENHA=and

# Só no Neon: o Flyway migra na subida, e o pooler (PgBouncer em modo
# transação) não é lugar para migração. Aponte o Flyway para o host SEM
# "-pooler". Vazio ou ausente = o Flyway usa o DATABASE_URL.
# SPRING_FLYWAY_URL=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=

# Gere um por ambiente:  openssl rand -base64 48
APP_JWT_SEGREDO=troque-isto-por-um-valor-aleatorio-de-no-minimo-32-bytes

# Origens com acesso direto à API pelo navegador (CORS), separadas por
# vírgula. O painel web passa pelo proxy do Next (mesma origem), então isto
# só importa para quem chamar a API direto do navegador, como o Swagger de
# outra máquina. O app do celular não usa CORS.
APP_CORS_ORIGENS=http://localhost:3000

# Em produção precisa ser true: o cookie de renovação só viaja em HTTPS.
APP_COOKIE_SEGURO=false

PORT=3333

# Atrás de proxy reverso (Fly, Render) use "native", senão o limite de
# tentativas de ativação por IP vira um limite único para todas as agentes.
# Sem proxy (local), deixe "none".
SERVER_FORWARD_HEADERS_STRATEGY=none

# Usados só pelo perfil criar-usuario. O e-mail é obrigatório: sem ele o
# perfil recusa rodar.
APP_USUARIO_INICIAL_EMAIL=associacao@amigosdone.org.br
APP_USUARIO_INICIAL_NOME=Associação Amigos do Nordeste
